      <Button
          android:id="@+id/ejec"
          android:layout_width="100dp"
          android:layout_height="wrap_content"
          android:layout_centerHorizontal="true"
          android:layout_marginTop="16dp"
          android:background="@drawable/boton"
          android:backgroundTint="@color/colorPrimary"
          android:enabled="true"
          android:text="@string/guardar"
          android:textColor="#fff"
          app:layout_constraintEnd_toEndOf="@+id/firmarOrd"
          app:layout_constraintStart_toStartOf="@+id/firmarOrd"
          app:layout_constraintTop_toBottomOf="@+id/tecCuadrilla" />


      <TextView
          android:id="@+id/tv_textTecSec"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="8dp"
          android:text="@string/tecnicoSecundario"
          android:textSize="20dp"
          android:textStyle="bold"
          android:visibility="visible"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

      <Spinner
          android:id="@+id/spinnerTecnicoSec"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/disenio_spinner"
          android:visibility="visible"
          app:layout_constraintEnd_toEndOf="@+id/tv_textTecSec"
          app:layout_constraintStart_toStartOf="@+id/tv_textTecSec"
          app:layout_constraintTop_toBottomOf="@+id/tv_textTecSec"
          tools:visibility="visible" />

      <Button
          android:id="@+id/salirEjecutarOrd"
          android:layout_width="100dp"
          android:layout_height="wrap_content"
          android:layout_below="@+id/animado9"
          android:layout_centerHorizontal="true"
          android:layout_marginStart="8dp"
          android:layout_marginTop="36dp"
          android:layout_marginEnd="8dp"
          android:background="@drawable/boton"
          android:backgroundTint="@color/colorPrimary"
          android:text="@string/salir"
          android:textColor="#fff"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintHorizontal_bias="0.491"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/spinnerTecnicoSec" />
      <!--app:layout_constraintTop_toBottomOf="@+id/ejecutarLay" -->

      <Button
          android:id="@+id/firmarOrd"
          android:layout_width="100dp"
          android:layout_height="wrap_content"
          android:layout_below="@+id/salirEjecutarOrd"
          android:layout_centerHorizontal="true"
          android:layout_marginTop="16dp"
          android:background="@drawable/boton"
          android:backgroundTint="@color/colorPrimary"
          android:text="@string/firmar"
          android:textColor="#fff"
          android:visibility="gone"
          app:layout_constraintEnd_toEndOf="@+id/salirEjecutarOrd"
          app:layout_constraintStart_toStartOf="@+id/salirEjecutarOrd"
          app:layout_constraintTop_toBottomOf="@+id/salirEjecutarOrd" />

      <Button
          android:id="@+id/tecCuadrilla"
          android:layout_width="100dp"
          android:layout_height="wrap_content"
          android:layout_below="@+id/salirEjecutarOrd"
          android:layout_centerHorizontal="true"
          android:layout_marginTop="16dp"
          android:background="@drawable/boton"
          android:backgroundTint="@color/colorPrimary"
          android:text="@string/cuadrilla"
          android:visibility="gone"
          android:textColor="#fff"
          app:layout_constraintEnd_toEndOf="@+id/salirEjecutarOrd"
          app:layout_constraintStart_toStartOf="@+id/salirEjecutarOrd"
          app:layout_constraintTop_toBottomOf="@+id/firmarOrd" />


      <TextView
          android:id="@+id/txtPlaca"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="4dp"
          android:text="@string/placa"
          android:textSize="20dp"
          android:textStyle="bold"
          android:visibility="visible"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintHorizontal_bias="0.0"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/ejec" />

      <EditText
          android:id="@+id/placa"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="4dp"
          android:layout_marginEnd="4dp"
          android:digits="0123456789-,qQwWeErRtTzZuUiIoOpPaAsSdDfFgGhHjJkKlLyYxXcCvVbBnNmM"
          android:textSize="20dp"
          android:visibility="visible"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/txtPlaca"
           />

      <TextView
          android:id="@+id/txtNap"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="8dp"
          android:text="@string/NAP"
          android:textSize="20dp"
          android:textStyle="bold"
          android:visibility="invisible"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintHorizontal_bias="0.0"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/placa"
           />

      <Spinner
          android:id="@+id/spinnerNap"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/disenio_spinner"
          android:visibility="invisible"
          app:layout_constraintEnd_toEndOf="@+id/txtNap"
          app:layout_constraintStart_toStartOf="@+id/txtNap"
          app:layout_constraintTop_toBottomOf="@+id/txtNap"
           />


      <TextView
          android:id="@+id/txtTap"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="8dp"
          android:text="@string/TAP"
          android:textSize="20dp"
          android:textStyle="bold"
          android:visibility="invisible"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintHorizontal_bias="1.0"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/spinnerNap"
           />

      <Spinner
          android:id="@+id/spinnerTap"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="4dp"
          android:background="@drawable/disenio_spinner"
          android:visibility="invisible"
          app:layout_constraintEnd_toEndOf="@+id/txtTap"
          app:layout_constraintStart_toStartOf="@+id/txtTap"
          app:layout_constraintTop_toBottomOf="@+id/txtTap"
           />

    </android.support.constraint.ConstraintLayout>
  </ScrollView>
</FrameLayout>