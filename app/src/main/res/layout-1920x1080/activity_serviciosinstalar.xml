<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android" >

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/textView4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="8dp"
            android:text="@string/serviciosInstalar"
            android:textAlignment="center"
            android:textSize="@dimen/titulos"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" /><!-- Titulo -->

        <android.support.constraint.ConstraintLayout
            android:id="@+id/ListaDeDetalles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            tools:visibility="visible">

            <TextView
                android:id="@+id/DetalleSaldoTitu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#485AC9"
                android:gravity="center"
                android:text="@string/detalle"
                android:textColor="#ffff"
                android:textSize="15dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtConceptoT"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/titulo_tabla"
                android:text="@string/concepto"
                android:textAlignment="center"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/txtImporteT"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/DetalleSaldoTitu" />

            <TextView
                android:id="@+id/txtImporteT"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="@drawable/titulo_tabla"
                android:text="@string/importe"
                android:textAlignment="center"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtConceptoT"
                app:layout_constraintTop_toTopOf="@+id/txtConceptoT" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/listaDetalles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#ffff"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtConceptoT" />

        </android.support.constraint.ConstraintLayout><!-- Detalles -->

        <android.support.constraint.ConstraintLayout
            android:id="@+id/Pagos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ListaDeDetalles">

            <TextView
                android:id="@+id/pago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#90AE9C"
                android:gravity="center"
                android:text="@string/pago"
                android:textColor="#FFFF"
                android:textSize="25dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <android.support.constraint.ConstraintLayout
                android:id="@+id/totales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toBottomOf="@+id/pago">

                <TextView
                    android:id="@+id/saldodia"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:text="@string/saldodia"
                    android:textAlignment="center"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/saldo"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/saldodia"
                    android:layout_alignStart="@+id/saldodia"
                    android:layout_alignEnd="@+id/saldodia"
                    android:text="$000.00"
                    android:textAlignment="center"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/saldodia"
                    app:layout_constraintStart_toStartOf="@+id/saldodia"
                    app:layout_constraintTop_toBottomOf="@+id/saldodia" />

                <TextView
                    android:id="@+id/saldoabonar"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Saldo a abonar"
                    android:textAlignment="center"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/saldo"
                    app:layout_constraintStart_toStartOf="@+id/saldo"
                    app:layout_constraintTop_toBottomOf="@+id/saldo" />

                <EditText
                    android:id="@+id/editTextNumberDecimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ems="7"
                    android:hint="000.00"
                    android:inputType="numberDecimal"
                    android:textSize="24sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/saldoabonar" />

                <TextView
                    android:id="@+id/textView74"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="@+id/editTextNumberDecimal"
                    app:layout_constraintEnd_toStartOf="@+id/editTextNumberDecimal"
                    app:layout_constraintTop_toTopOf="@+id/editTextNumberDecimal" />
            </android.support.constraint.ConstraintLayout>


            <android.support.constraint.ConstraintLayout
                android:id="@+id/Botones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="50dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/totales">

                <Button
                    android:id="@+id/cerrar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="false"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:drawableLeft="@drawable/salir"
                    android:text="@string/abonar"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </android.support.constraint.ConstraintLayout><!-- Boton -->


        </android.support.constraint.ConstraintLayout><!-- Pago -->

    </android.support.constraint.ConstraintLayout>
</ScrollView>