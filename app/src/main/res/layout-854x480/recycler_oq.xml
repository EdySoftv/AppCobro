<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:elevation="80dp">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/disenio_recyclerview"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/contrto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="Contrato"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/noOrden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:text="No. de Orden"
            app:layout_constraintStart_toEndOf="@+id/contrto"
            tools:layout_editor_absoluteY="0dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="8dp"
            android:text="Estatus"
            app:layout_constraintEnd_toEndOf="@+id/controla"
            app:layout_constraintStart_toEndOf="@+id/noOrden"
            tools:layout_editor_absoluteY="0dp" />

        <TextView
            android:id="@+id/controla"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.75"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/tv_NContrato"
            android:layout_width="87dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            android:text="2660-22"
            android:textSize="@dimen/mediano"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/contrto"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_Nombre"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="SELENE PEREZ MENDOZA"
            android:textSize="@dimen/chico"
            app:layout_constraintStart_toStartOf="@+id/tv_NContrato"
            app:layout_constraintTop_toBottomOf="@+id/tv_NContrato" />

        <TextView
            android:id="@+id/tv_NOrden"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:text="1025"
            android:textSize="@dimen/mediano"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_NContrato"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_NContrato"
            app:layout_constraintTop_toTopOf="@+id/tv_NContrato"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/tv_estatus"
            android:layout_width="45dp"
            android:layout_height="27dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:textSize="18dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_NOrden"
            app:layout_constraintEnd_toEndOf="@+id/controla"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/tv_NOrden"
            app:layout_constraintTop_toBottomOf="@+id/status" />

        <TextView
            android:id="@+id/txt"
            android:layout_width="53dp"
            android:layout_height="13dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/direccion"
            android:textSize="@dimen/chico"
            app:layout_constraintEnd_toStartOf="@+id/tv_estatus"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/tv_Nombre"
            app:layout_constraintTop_toBottomOf="@+id/tv_Nombre" />

        <TextView
            android:id="@+id/id_direccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/chico"
            app:layout_constraintBottom_toBottomOf="@+id/txt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/txt"
            app:layout_constraintTop_toTopOf="@+id/txt"
            app:layout_constraintVertical_bias="0.0" />

    </android.support.constraint.ConstraintLayout>
</android.support.v7.widget.CardView>