<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:elevation="5dp">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/disenio_recyclerview"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/tv_Descripcion"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center|left"
            android:maxLines="3"
            android:text="CAPAG - Cambio de tipo de aparato"
            android:textSize="12dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/click"
            app:layout_constraintTop_toTopOf="@+id/click" />

        <CheckBox
            android:id="@+id/check_recibi"
            android:layout_width="39dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/recibitext"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/recibitext"
            app:layout_constraintTop_toBottomOf="@+id/recibitext"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/recibitext"
            android:layout_width="46dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:text="@string/recibi"
            android:textAlignment="textEnd"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/tv_Descripcion"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/click"
            android:layout_width="250dp"
            android:layout_height="67dp"
            tools:layout_editor_absoluteX="8dp" />

        <TextView
            android:id="@+id/observacionesTrabajo"
            android:layout_width="236dp"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:textSize="10dp"
            android:text="Observaciones"
            app:layout_constraintBottom_toBottomOf="@+id/click"
            app:layout_constraintEnd_toEndOf="@+id/tv_Descripcion"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/tv_Descripcion"
            app:layout_constraintTop_toBottomOf="@+id/tv_Descripcion"
            app:layout_constraintVertical_bias="0.0" />


    </android.support.constraint.ConstraintLayout>
</android.support.v7.widget.CardView>