<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:elevation="80dp">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/disenio_recyclerview"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/contrto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="Contrato"
            android:textSize="18dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/controla" />

        <TextView
            android:id="@+id/noOrden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:layout_marginTop="16dp"
            android:text="No. de Orden"
            android:textSize="18dp"
            app:layout_constraintStart_toEndOf="@+id/contrto"
            app:layout_constraintTop_toTopOf="@+id/controla" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="16dp"
            android:text="Estatus"
            android:textSize="18dp"
            app:layout_constraintStart_toEndOf="@+id/noOrden"
            app:layout_constraintTop_toTopOf="@+id/controla" />


        <TextView
            android:id="@+id/controla"
            android:layout_width="368dp"
            android:layout_height="144dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_NContrato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="2660-22"
            android:textSize="22dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/controla"
            app:layout_constraintTop_toBottomOf="@+id/contrto" />

        <TextView
            android:id="@+id/tv_Nombre"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="SELENE PEREZ MENDOZA"
            app:layout_constraintStart_toStartOf="@+id/controla"
            app:layout_constraintTop_toBottomOf="@+id/tv_NContrato" />

        <TextView
            android:id="@+id/tv_NOrden"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:layout_marginTop="8dp"
            android:text="1025"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/tv_NContrato"
            app:layout_constraintTop_toBottomOf="@+id/noOrden" />

        <TextView
            android:id="@+id/tv_estatus"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="72dp"
            android:layout_marginTop="16dp"
            android:textSize="16dp"
            app:layout_constraintStart_toEndOf="@+id/tv_NOrden"
            app:layout_constraintTop_toBottomOf="@+id/status" />

        <TextView
            android:id="@+id/txt"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/direccion"
            app:layout_constraintStart_toStartOf="@+id/controla"
            app:layout_constraintTop_toBottomOf="@+id/tv_Nombre" />

        <TextView
            android:id="@+id/id_direccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txt"
            app:layout_constraintTop_toTopOf="@+id/txt" />

    </android.support.constraint.ConstraintLayout>
</android.support.v7.widget.CardView>