<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.HorasReportes">
    <android.support.constraint.ConstraintLayout
        android:id="@+id/rb"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="89dp">

        <RadioGroup
            android:id="@+id/grupo_dias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/ejutada1"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                android:text="@string/visita"
                android:textSize="22dp" />

            <RadioButton
                android:id="@+id/visitada1"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/ejecutar"
                android:textSize="22dp" />
        </RadioGroup>
    </android.support.constraint.ConstraintLayout>
    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="120dp"
        android:verticalScrollbarPosition="defaultPosition"
        android:visibility="visible">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/RV7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/RE1"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView40"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/RV1"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/ObservacionesTecnico"
                android:textSize="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/problema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtw"
                android:layout_alignStart="@+id/uno"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/contorno"
                android:inputType="text"
                android:textSize="22dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView40" />

            <Button
                android:id="@+id/salirReporte"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ejecutarR"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:background="@drawable/boton"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/salir"
                android:textColor="#fff"
                app:layout_constraintEnd_toEndOf="@+id/salirR"
                app:layout_constraintStart_toStartOf="@+id/salirR"
                app:layout_constraintTop_toBottomOf="@+id/salirR" />

            <Button
                android:id="@+id/salirR"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ejecutarR"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/boton"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/guardar"
                android:textColor="#fff"
                app:layout_constraintEnd_toEndOf="@+id/problema"
                app:layout_constraintHorizontal_bias="0.514"
                app:layout_constraintStart_toStartOf="@+id/problema"
                app:layout_constraintTop_toBottomOf="@+id/problema" />

        </android.support.constraint.ConstraintLayout>
    </ScrollView>
</FrameLayout>