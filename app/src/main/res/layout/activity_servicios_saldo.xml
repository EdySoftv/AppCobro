<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <android.support.constraint.ConstraintLayout
        android:id="@+id/ContenidoInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/DatosCliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="103dp"
                android:layout_height="103dp"
                android:layout_alignTop="@+id/nombre"
                android:layout_alignBottom="@+id/textView10"
                android:layout_alignParentStart="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/logo"
                app:layout_constraintBottom_toBottomOf="@+id/textplaca"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/nombre" />

            <TextView
                android:id="@+id/nombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:text="---"
                android:textColor="@color/negro"
                android:textSize="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.02"
                app:layout_constraintStart_toEndOf="@+id/imageView2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nombre"
                android:layout_alignStart="@+id/nombre"
                android:layout_marginTop="10dp"
                android:text="@string/contrato"
                android:textAlignment="textStart"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@+id/nombre"
                app:layout_constraintTop_toBottomOf="@+id/nombre" />


            <TextView
                android:id="@+id/direccion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/textView9"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/textView8"
                android:text="sn Direccion"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/textView9"
                app:layout_constraintEnd_toEndOf="@+id/nombre"
                app:layout_constraintStart_toEndOf="@+id/textView9"
                app:layout_constraintTop_toTopOf="@+id/textView9" />

            <TextView
                android:id="@+id/contrato"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/textView8"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/textView8"
                android:text="Sn contrato"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/textView8"
                app:layout_constraintEnd_toEndOf="@+id/nombre"
                app:layout_constraintStart_toEndOf="@+id/textView8"
                app:layout_constraintTop_toTopOf="@+id/textView8" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView8"
                android:layout_alignStart="@+id/textView8"
                android:layout_alignEnd="@+id/textView8"
                android:layout_marginTop="10dp"
                android:text="@string/direccion"
                android:textAlignment="textStart"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@+id/textView8"
                app:layout_constraintTop_toBottomOf="@+id/textView8" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/direccion"
                android:layout_alignStart="@+id/textView8"
                android:layout_alignEnd="@+id/textView8"
                android:layout_marginTop="10dp"
                android:text="@string/telefonoDos"
                android:textAlignment="textStart"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@+id/textView9"
                app:layout_constraintTop_toBottomOf="@+id/textView9" />

            <TextView
                android:id="@+id/telefono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/textView10"
                android:layout_alignBottom="@+id/textView10"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/textView8"
                android:text="sn telefono"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/textView10"
                app:layout_constraintEnd_toEndOf="@+id/nombre"
                app:layout_constraintStart_toEndOf="@+id/textView10"
                app:layout_constraintTop_toTopOf="@+id/textView10" />

            <TextView
                android:id="@+id/textplaca"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/direccion"
                android:layout_alignStart="@+id/textView8"
                android:layout_alignEnd="@+id/textView8"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="@string/placa"
                android:textAlignment="textStart"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/textView10"
                app:layout_constraintTop_toBottomOf="@+id/textView10" />

            <TextView
                android:id="@+id/placa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/textView10"
                android:layout_alignBottom="@+id/textView10"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/textView8"
                android:text="sn placa"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/textplaca"
                app:layout_constraintEnd_toEndOf="@+id/nombre"
                app:layout_constraintStart_toEndOf="@+id/textplaca"
                app:layout_constraintTop_toTopOf="@+id/textplaca" />

        </android.support.constraint.ConstraintLayout> <!-- Datos -->

        <android.support.constraint.ConstraintLayout
            android:id="@+id/ListaDeServicios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/DatosCliente"
            tools:visibility="gone">

            <TextView
                android:id="@+id/servicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#485AC9"
                android:gravity="center"
                android:text="@string/servicios"
                android:textColor="#FFFF"
                android:textSize="25dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/listaServicios"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_below="@+id/servicios"
                android:layout_marginTop="8dp"
                android:background="#ffff"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/servicios" />

        </android.support.constraint.ConstraintLayout><!-- Servicios -->

        <android.support.constraint.ConstraintLayout
            android:id="@+id/ListaDeDetalles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ListaDeServicios"
            tools:visibility="gone">

            <TextView
                android:id="@+id/DetalleSaldoTitu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#485AC9"
                android:gravity="center"
                android:text="@string/detalle"
                android:textColor="#ffff"
                android:textSize="25dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtConceptoT"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/titulo_tabla"
                android:text="@string/concepto"
                android:textAlignment="center"
                app:layout_constraintEnd_toStartOf="@+id/txtImporteT"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/DetalleSaldoTitu" />

            <TextView
                android:id="@+id/txtImporteT"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="@drawable/titulo_tabla"
                android:text="@string/importe"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtConceptoT"
                app:layout_constraintTop_toTopOf="@+id/txtConceptoT" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/listaDetalles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#ffff"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtConceptoT" />

        </android.support.constraint.ConstraintLayout><!-- Detalles -->

        <android.support.constraint.ConstraintLayout
            android:id="@+id/Pagos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ListaDeDetalles">

            <TextView
                android:id="@+id/pago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#90AE9C"
                android:gravity="center"
                android:text="@string/pago"
                android:textColor="#FFFF"
                android:textSize="25dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_below="@+id/pago"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:src="@drawable/lineaseparadora"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pago" />

            <TextView
                android:id="@+id/saldodia"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pago"
                android:layout_alignParentStart="true"
                android:layout_marginTop="16dp"
                android:layout_toStartOf="@+id/pagoantesdel"
                android:text="@string/saldodia"
                android:textAlignment="center"
                android:textSize="15dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/imageView3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pago" />

            <TextView
                android:id="@+id/saldo"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/saldodia"
                android:layout_alignStart="@+id/saldodia"
                android:layout_alignEnd="@+id/saldodia"
                android:text="$000.00"
                android:textAlignment="center"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/imageView3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/saldodia" />

            <TextView
                android:id="@+id/pagoantesdel"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pago"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="16dp"
                android:text="@string/periodo"
                android:textSize="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView3"
                app:layout_constraintTop_toBottomOf="@+id/pago" />

            <TextView
                android:id="@+id/consultadoDia"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pagoantesdel"
                android:layout_alignStart="@+id/pagoantesdel"
                android:layout_alignEnd="@+id/pagoantesdel"
                android:layout_marginTop="5dp"
                android:text="00/00/0000"
                android:textAlignment="center"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView3"
                app:layout_constraintTop_toBottomOf="@+id/pagoantesdel" />

            <android.support.constraint.ConstraintLayout
                android:id="@+id/PrimerBoton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView3">

                <Button
                    android:id="@+id/detallesaldo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="false"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:drawableLeft="@drawable/saldo"
                    android:text="@string/detallesaldo"
                    android:textSize="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </android.support.constraint.ConstraintLayout><!-- Boton -->

            <android.support.constraint.ConstraintLayout
                android:id="@+id/SerieYFolio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/PrimerBoton"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/TextViewVendedor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/vendedor"
                    android:textSize="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Spinner
                    android:id="@+id/SpinnerVendedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:textSize="15dp"
                    android:background="@drawable/disenio_spinner"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/TextViewVendedor" />

                <TextView
                    android:id="@+id/TextViewSerie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/serie"
                    android:textSize="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/SpinnerVendedor" />

                <Spinner
                    android:id="@+id/SpinnerSerie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:textSize="15dp"
                    android:background="@drawable/disenio_spinner"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/TextViewSerie" />

                <TextView
                    android:id="@+id/TextViewFolioTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/foliotv"
                    android:textSize="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/SpinnerSerie" />

                <Spinner
                    android:id="@+id/SpinnerFolioTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:textSize="15dp"
                    android:background="@drawable/disenio_spinner"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/TextViewFolioTv" />

                <TextView
                    android:id="@+id/TextViewFolioInternet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/foliointernet"
                    android:textSize="15dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/SpinnerFolioTv" />

                <Spinner
                    android:id="@+id/SpinnerFolioInternet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:textSize="15dp"
                    android:background="@drawable/disenio_spinner"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/TextViewFolioInternet" />

            </android.support.constraint.ConstraintLayout><!-- Serie y folio -->

            <android.support.constraint.ConstraintLayout
                android:id="@+id/Botones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/SerieYFolio">

                <Button
                    android:id="@+id/cerrar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="false"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:drawableLeft="@drawable/salir"
                    android:text="@string/pagar"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/adelantar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="false"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="40dp"
                    android:drawableLeft="@drawable/salir"
                    android:text="Abono a cuenta"
                    android:textSize="20dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cerrar"
                    tools:visibility="visible" />



            </android.support.constraint.ConstraintLayout><!-- Boton -->


        </android.support.constraint.ConstraintLayout><!-- Pago -->

    </android.support.constraint.ConstraintLayout>
</ScrollView>