<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible">

    <android.support.v4.view.ViewPager xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="16dp"></android.support.v4.view.ViewPager>

    <android.support.constraint.ConstraintLayout
        android:id="@+id/constraintLayout6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/qwe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:text="@string/tecnicoDos"
            android:textColor="#000"
            app:layout_constraintStart_toEndOf="@+id/info"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tecniconame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="8dp"
            android:text="---"
            app:layout_constraintBottom_toBottomOf="@+id/qwe"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/zaw"
            app:layout_constraintTop_toTopOf="@+id/qwe" />

        <Button
            android:id="@+id/info"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/boton"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="#fff"
            android:text="@string/datos_Cliente"
            android:textSize="7dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/zaw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="8dp"
            android:text="@string/contratoDos"
            android:textColor="#000"
            app:layout_constraintEnd_toEndOf="@+id/qwe"
            app:layout_constraintStart_toStartOf="@+id/qwe"
            app:layout_constraintTop_toBottomOf="@+id/qwe" />

        <TextView
            android:id="@+id/contrato"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@+id/zaw"
            android:hint="---"
            app:layout_constraintBottom_toBottomOf="@+id/zaw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/zaw"
            app:layout_constraintTop_toTopOf="@+id/zaw" />

        <TextView
            android:id="@+id/txtqwe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="8dp"
            android:text="@string/estatusDos"
            android:textColor="#000"
            app:layout_constraintEnd_toEndOf="@+id/qwe"
            app:layout_constraintStart_toStartOf="@+id/qwe"
            app:layout_constraintTop_toBottomOf="@+id/zaw" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="8dp"
            android:hint="---"
            app:layout_constraintBottom_toBottomOf="@+id/txtqwe"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/zaw"
            app:layout_constraintTop_toTopOf="@+id/txtqwe" />
    </android.support.constraint.ConstraintLayout>

    <ScrollView
        android:id="@+id/scv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/contorno"
        android:verticalScrollbarPosition="defaultPosition"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout6">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/animado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:background="@drawable/contorno"
            android:backgroundTint="@color/colorPrimary"
            android:visibility="gone">

            <TextView
                android:id="@+id/asd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="8dp"
                android:text="@string/info_Usuario"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/as"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/asd"
                android:layout_alignParentStart="true"
                android:layout_marginTop="16dp"
                android:text="@string/nombreDos"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/asd"
                app:layout_constraintStart_toStartOf="@+id/asd"
                app:layout_constraintTop_toBottomOf="@+id/asd" />

            <TextView
                android:id="@+id/infonombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/as"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:hint="---"
                android:textSize="20dp"
                app:layout_constraintEnd_toEndOf="@+id/asd"
                app:layout_constraintStart_toStartOf="@+id/asd"
                app:layout_constraintTop_toBottomOf="@+id/as" />

            <TextView
                android:id="@+id/wre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/infonombre"
                android:layout_alignParentStart="true"
                android:layout_marginTop="16dp"
                android:text="@string/direccionDos"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/asd"
                app:layout_constraintStart_toStartOf="@+id/asd"
                app:layout_constraintTop_toBottomOf="@+id/infonombre" />

            <TextView
                android:id="@+id/infodireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/wre"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:text="---"
                android:textSize="20dp"
                app:layout_constraintEnd_toEndOf="@+id/asd"
                app:layout_constraintStart_toStartOf="@+id/asd"
                app:layout_constraintTop_toBottomOf="@+id/wre" />

            <TextView
                android:id="@+id/jkl"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@+id/infodireccion"
                android:layout_alignParentStart="true"
                android:layout_marginTop="16dp"
                android:text="@string/servicios_Asignados"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/asd"
                app:layout_constraintStart_toStartOf="@+id/asd"
                app:layout_constraintTop_toBottomOf="@+id/infodireccion" />

            <TextView
                android:id="@+id/infoservicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/jkl"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:ems="10"
                android:gravity="center"
                android:inputType="textMultiLine"
                android:textAlignment="center"
                android:textSize="20dp"
                app:layout_constraintEnd_toEndOf="@+id/asd"
                app:layout_constraintStart_toStartOf="@+id/asd"
                app:layout_constraintTop_toBottomOf="@+id/jkl" />
        </android.support.constraint.ConstraintLayout>

    </ScrollView>

</android.support.constraint.ConstraintLayout>
